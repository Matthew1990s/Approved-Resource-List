{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "platform/resource-list",
  "version": "1.0.0",
  "title": "Approved Resource List",
  "category": "widgets",
  "icon": "list-view",
  "description": "Displays locally synchronized public resources for this site.",
  "textdomain": "approved-resource-list",
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "headingLevel": {
      "type": "number",
      "default": 2
    },
    "limit": {
      "type": "number",
      "default": 6
    },
    "showSummary": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "color": {
      "text": false,
      "background": false
    },
    "spacing": {
      "margin": ["top", "bottom"]
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css"
}
